{
  "name": "capacitor-plugins-demo",
  "version": "1.0.0",
  "description": "Capacitor demo app showcasing all major native plugins (Camera, Filesystem, Geolocation, Notifications, Share, Clipboard, Device, Battery, Haptics, Network, Preferences, Browser, App, StatusBar, SplashScreen, ScreenOrientation, Keyboard, Local Notifications, Push Notifications, Motion/Sensors, and more)",
  "main": "index.js",
  "scripts": {
    "start": "npx serve www -p 3000",
    "build": "echo 'Static web assets - no build step needed' && exit 0",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios"
  },
  "keywords": [
    "capacitor",
    "demo",
    "plugins",
    "android",
    "ios",
    "camera",
    "geolocation",
    "notifications"
  ],
  "author": "Grok Demo",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/camera": "^6.1.0",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.2",
    "@capacitor/dialog": "^6.0.2",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/geolocation": "^6.0.2",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/network": "^6.0.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/screen-orientation": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/toast": "^6.0.2",
    "@capacitor/motion": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "serve": "^14.2.4"
  }
}
